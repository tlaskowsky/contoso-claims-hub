// Dead-letter accumulation on the Service Bus namespace (from diagnostic
// metrics sent to Log Analytics), plus the exceptions that caused it.
AzureMetrics
| where TimeGenerated > ago(1d)
| where ResourceProvider == "MICROSOFT.SERVICEBUS" and MetricName == "DeadletteredMessages"
| summarize DeadLettered = max(Maximum) by bin(TimeGenerated, 5m), Resource
| order by TimeGenerated desc;

